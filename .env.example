# Volunteertrac — optional overrides. Copy to .env to use.
PORT=8080                # host port the app is published on
TZ=UTC                   # container timezone

# Admin user provisioned at first boot (change the password!)
ADMIN_NAME=Alex Morgan
ADMIN_EMAIL=admin@volunteertrac.local
ADMIN_PASSWORD=changeme

# White-label: organization name (empty = keep the built-in default)
ORG_NAME=

# Email server (leave SMTP_HOST empty to queue mail in the in-app outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
